# ===== ספק ה-LLM =====
# הבוט תומך ב-Gemini (Google) או Claude (Anthropic). הגדר לפחות מפתח אחד.
# auto = Gemini אם יש מפתח Gemini, אחרת Anthropic, אחרת מצב בדיקה.
AGENT_PROVIDER=auto

# Gemini (Google AI Studio — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-4-8

# הגבלה לנושאי ביטוח בלבד (עם העברה לאישור על השאר).
# false = הבוט עונה גם על הודעות בסיסיות רגילות (טוב לבדיקה מהירה).
INSURANCE_ONLY=true

# ===== מצב הבוט =====
# false (ברירת מחדל) = האזנה בלבד, הבוט לא עונה במקומך.
# true = הבוט פעיל ועונה (בכפוף לסינונים למטה).
BOT_ENABLED=false

# ===== Kill Switch =====
# פקודות שנשלחות מהטלפון שלך (לכל שיחה שהיא) לכיבוי/הדלקה מרחוק.
KILL_SWITCH_ON=!bot-on
KILL_SWITCH_OFF=!bot-off

# ===== סינונים =====
# מספרים מורשים, מופרדים בפסיק, בפורמט בינלאומי ללא + (ריק = כל המספרים).
ALLOWED_NUMBERS=972501234567,972529876543

# מילת מפתח שההודעה חייבת להתחיל בה. השאר ריק כדי לענות על כל הודעה.
TRIGGER_KEYWORD=!bot

# ===== אישור בעל החשבון (Human-in-the-loop) =====
# הבוט עונה לבד רק על נושאי ביטוח. כל דבר אחר, או כשהוא לא בטוח, מועבר
# למספר הזה לאישור לפני שליחה. פורמט מקומי (0525283323) או בינלאומי.
# ריק = ללא העברה (הבוט פשוט לא יענה על מה שאינו ביטוח).
OWNER_NUMBER=0525283323

# מילות מפתח לזיהוי נושא ביטוח במצב בדיקה (מופרד בפסיקים).
# INSURANCE_KEYWORDS=ביטוח,פוליסה,כיסוי,תביעה,פרמיה,רכב,דירה,בריאות,חיים

# האם לענות בקבוצות (ברירת מחדל: false)
RESPOND_IN_GROUPS=false

# ===== צימוד למספר שלך =====
# המספר שלך בפורמט בינלאומי ללא + . אם מוגדר — תקבל קוד צימוד להזנה בטלפון
# במקום סריקת QR (וואטסאפ ← מכשירים מקושרים ← קישור מכשיר ← קשר באמצעות מספר טלפון).
# השאר ריק כדי להתחבר בסריקת QR רגילה.
PAIRING_PHONE_NUMBER=972501234567

# קידומת לתגובות הבוט כדי להבחין בינן לבין הודעות שכתבת בעצמך (ריק = ללא סימון).
BOT_REPLY_PREFIX=🤖

# ===== חיווי אנושי =====
# טווח ההשהיה (מילישניות) לפני שליחת תגובה, נבחר אקראית.
MIN_REPLY_DELAY_MS=2000
MAX_REPLY_DELAY_MS=5000

# ===== דשבורד ווב =====
# ממשק דפדפן: סטטוס, צימוד, לוג הודעות וכפתור הדלקה/כיבוי.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
# ברירת מחדל: נגיש רק מהמחשב עצמו (127.0.0.1). לחשיפה לאינטרנט ראה README.
DASHBOARD_HOST=127.0.0.1
# חובה אם חושפים לאינטרנט (שם המשתמש: admin). בחר סיסמה חזקה!
DASHBOARD_PASSWORD=

# ===== הגדרות הסוכן =====
AGENT_MAX_TOKENS=1024
AGENT_HISTORY_TURNS=20
# AGENT_SYSTEM_PROMPT=הנחיות מותאמות אישית לסוכן (מצב ביטוח)...
# AGENT_GENERAL_SYSTEM_PROMPT=הנחיות לסוכן במצב כללי (INSURANCE_ONLY=false)...
