# --- Gmail ---
# כתובת ה-Gmail שהבוט מאזין לה ועונה ממנה
GMAIL_ADDRESS=you@gmail.com
# App Password (לא הסיסמה הרגילה!) - נוצר ב: https://myaccount.google.com/apppasswords
# דורש אימות דו-שלבי מופעל בחשבון
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Gemini ---
# מפתח API מ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- התנהגות ---
# המייל שאליו נשלחות טיוטות לאישור כשהביטחון נמוך
APPROVAL_EMAIL=approver@example.com
# סף ביטחון (0-1): מעל הסף - תשובה נשלחת ישירות ללקוח; מתחת - נשלחת לאישור
CONFIDENCE_THRESHOLD=0.8
# כל כמה שניות לבדוק מיילים חדשים
POLL_INTERVAL_SECONDS=60
# קובץ הפרומפט שמנחה את Gemini איך לענות
PROMPT_FILE=prompt.txt
# true = לא שולח מיילים בפועל, רק מדפיס ללוג (מומלץ לניסוי ראשון)
DRY_RUN=true
